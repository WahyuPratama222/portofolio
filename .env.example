# Drizzle
# Postgres connection string (Settings > Connect), NOT the https URL.
# Local: Docker Postgres. Production: Supabase pooler (port 6543).
DATABASE_URL=

# Supabase
# Base project URL only, no trailing slash or /rest/v1 (https://xxxx.supabase.co)
SUPABASE_URL=
# Public anon key (eyJ...). Never put the service_role key here.
SUPABASE_ANON_KEY=

# Resend
# API key from the Resend dashboard
RESEND_API_KEY=
# Sender address, must be on a domain verified in Resend
CONTACT_FROM_EMAIL=
# Inbox that receives messages from the contact form
CONTACT_TO_EMAIL=

# Upstash
# REST credentials from the Upstash Redis console
# (used for contact rate limiting and the GitHub contributions cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SEO
# Public site URL, no trailing slash (e.g. https://xxxx.vercel.app).
# Optional: falls back to http://localhost:5173 when empty.
PUBLIC_SITE_URL=